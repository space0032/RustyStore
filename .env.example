# RustyStore environment configuration
# Copy to .env and adjust for your deployment.

RUST_LOG=info,rustystore=debug
RUST_BACKTRACE=1

# Coordinator
COORDINATOR_ADDR=0.0.0.0:50051
COORDINATOR_HTTP_ADDR=0.0.0.0:8081

# Gateway
GATEWAY_ADDR=0.0.0.0:8080
# Comma-separated coordinator addresses for failover. Overrides COORDINATOR_ADDR
# when set (for example: coordinator-a:50051,coordinator-b:50051).
COORDINATOR_ADDRS=
API_KEY=changeme
REQUIRE_AUTH=false

# Gateway rate limiting (per client IP, shared via the coordinator).
# RATE_LIMIT_RPS=0 disables; burst defaults to 2 * RPS when unset.
RATE_LIMIT_RPS=0
RATE_LIMIT_BURST=0

# Maximum accepted upload size in bytes (0 = unlimited)
MAX_UPLOAD_BYTES=0

# Storage node
NODE_ADDR=0.0.0.0:50051
# Address advertised to the coordinator and other nodes. Defaults to NODE_ADDR;
# set it when the bind address is not reachable by peers.
# ADVERTISED_ADDR=127.0.0.1:50051
STORAGE_PATH=/data/chunks
STORAGE_NODE_HTTP_ADDR=0.0.0.0:8082

# Database
DATABASE_URL=postgres://rustystore:rustystore@localhost:5432/rustystore

# Storage tuning
CHUNK_SIZE_BYTES=4194304
REPLICATION_FACTOR=3

# Orphan-chunk GC (coordinator; interval 0 disables collection)
ORPHAN_GC_INTERVAL_SECS=300
ORPHAN_GRACE_SECS=3600
UPLOAD_SESSION_TTL_SECS=86400

# Recovery bandwidth per transfer in bytes/sec (0 or unset = unlimited)
RECOVERY_BANDWIDTH_BYTES_PER_SEC=0

# gRPC TLS/mTLS. Leave all unset for plaintext (development default).
# Server identity; set on coordinator and storage nodes.
# GRPC_TLS_CERT=/certs/server.crt
# GRPC_TLS_KEY=/certs/server.key
# Require client certificates (mTLS) on a server.
# GRPC_TLS_CLIENT_CA=/certs/ca.crt
# Client trust root and optional identity; set on every gRPC client.
# GRPC_TLS_CA=/certs/ca.crt
# GRPC_TLS_CLIENT_CERT=/certs/client.crt
# GRPC_TLS_CLIENT_KEY=/certs/client.key
# Expected server name when it differs from the endpoint host.
# GRPC_TLS_DOMAIN=coordinator
